# ============================================
# Sudemy — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug

# ============================================
# MongoDB
# ============================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sudemy?retryWrites=true&w=majority

# ============================================
# JWT
# ============================================
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# ============================================
# Firebase Admin SDK
# ============================================
FIREBASE_PROJECT_ID=sudemy-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sudemy-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================
# Firebase Client (Vite — prefix with VITE_)
# ============================================
VITE_API_URL=http://localhost:5000/api/v1
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=sudemy-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sudemy-xxxxx

# ============================================
# PayOS
# ============================================
PAYOS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PAYOS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PAYOS_CHECKSUM_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# ============================================
# Resend (Email)
# ============================================
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# ============================================
# Google Gemini AI (AI Tutor)
# ============================================
GEMINI_API_KEY=your-gemini-api-key-from-aistudio

# ============================================
# Google Analytics 4
# ============================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
